<html>
    <head>
        <link rel="icon" href="./favicon.ico" />
        <meta charset="utf-8" />
        <title><%=title%></title>
        <meta
            name="viewport"
            content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true,viewport-fit=cover"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="full-screen" content="yes" />
        <meta name="screen-orientation" content="portrait" />
        <meta name="x5-fullscreen" content="true" />
        <meta name="360-fullscreen" content="true" />
        <meta name="renderer" content="webkit" />
        <meta name="force-rendering" content="webkit" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

        <link rel="stylesheet" type="text/css" href="./index.css" />
        <link rel="stylesheet" type="text/css" href="./loading-boot.css" />
        <style>
            /* Replace Cocos preview splash with elex branding. */
            #splash:not(.is-done) {
                position: absolute !important;
                inset: 0 !important;
                display: block !important;
                visibility: visible !important;
                opacity: 1 !important;
                z-index: 2147483646 !important;
                background: #000 !important;
                transform: translateZ(0);
            }
            #Cocos3dGameContainer,
            #GameCanvas {
                position: relative;
                z-index: 0 !important;
            }
            #splash.is-done {
                display: none !important;
            }
            /* <img> avoids CSS-background race: splash can dismiss before url() decodes. */
            #splash,
            #splash .elex-splash {
                pointer-events: auto;
                cursor: pointer;
            }
            #splash .elex-splash {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                background: #000;
            }
            #splash .progress-bar {
                display: none !important;
            }

            /*
             * Lock GameDiv to max 9:16. Outside the frame is black.
             * Engine SHOW_ALL / FIXED_WIDTH keeps design width at 1080.
             */
            .content,
            .contentWrap {
                background-color: #000 !important;
            }
            #GameDiv {
                position: relative !important;
                flex: none !important;
                width: var(--game-frame-width, auto) !important;
                height: var(--game-frame-height, 100%) !important;
                max-width: 100% !important;
                max-height: 100% !important;
                aspect-ratio: 9 / 16 !important;
                margin: auto !important;
                overflow: hidden !important;
                background-color: #000 !important;
            }
            #Cocos3dGameContainer,
            #GameCanvas {
                width: 100% !important;
                height: 100% !important;
                background-color: #000 !important;
            }

            /* Hide Cocos preview debug toolbar (design res / FPS / Pause). */
            .toolbar {
                display: none !important;
            }
            .content {
                top: 0 !important;
                height: 100% !important;
            }
        </style>
    </head>
    <body style="overflow: hidden; background-color: #000;">
        <%# Toolbar kept in template for Cocos preview injection; hidden via CSS above. %>
        <%- include(cocosToolBar, {config: config}) %>
        <div id="content" class="content" style="overflow: hidden; background-color: #000;">
            <div class="contentWrap">
                <!-- 9:16 frame; black outside. Design 1080 fills this frame. -->
                <div id="GameDiv" class="wrapper" cc_exact_fit_screen="false">
                    <div id="Cocos3dGameContainer">
                        <canvas id="GameCanvas" tabindex="-1" style="background-color: #000;"></canvas>
                    </div>
                    <div id="splash">
                        <img class="elex-splash" src="./splash_screen.webp" alt="elex" />
                        <svg class="splash-start" viewBox="0 0 860 156" role="img" aria-label="开始游戏">
                            <text x="430" y="108" text-anchor="middle" font-family="ZCOOL KuaiLe, PingFang SC, Microsoft YaHei, sans-serif" font-size="96" fill="#fff2d2" stroke="#281c0e" stroke-opacity="0.9" stroke-width="16" stroke-linejoin="round" paint-order="stroke fill">开始游戏</text>
                        </svg>
                        <div class="progress-bar stripes"><span></span></div>
                    </div>
                    <div id="boot" class="is-idle">
                        <img class="boot-bg" src="./loading_bg.webp" alt="" />
                        <div class="boot-stack">
                            <div class="boot-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="加载进度">
                                <img class="boot-track" src="./load-bar-track.png" alt="" />
                                <div class="boot-mask"><img class="boot-fill" src="./load-bar-fill.png" alt="" /></div>
                            </div>
                            <div class="boot-label">加载中...</div>
                        </div>
                    </div>
                    <div id="bulletin">
                        <div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div>
                    </div>
                    <div class="error" id="error">
                        <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
                        <div class="error-main"></div>
                        <div class="error-stack"></div>
                    </div>
                </div>
            </div>
        </div>
        <%- include(cocosTemplate, {}) %>
        <link rel="preload" as="image" href="./loading_bg.webp" />
        <link rel="preload" as="image" href="./splash_screen.webp" />
        <script src="./loading-boot.js"></script>
        <script>
            // Patch engine splash before bootstrap: no Cocos logo.
            // Elex art is the #splash <img> (reliable); engine canvas stays black.
            // (Previously base64:'./splash_screen.webp' was invalid and raced to a blank canvas.)
            (function () {
                var settings = window._CCSettings;
                if (!settings) {
                    return;
                }
                var splash = settings.splashScreen || (settings.splashScreen = {});
                // Branding is DOM #splash only — in-game cover stays black (no second elex).
                splash.totalTime = 0;
                splash.displayRatio = 1;
                splash.logo = { type: 'none' };
                splash.background = {
                    type: 'color',
                    color: { x: 0, y: 0, z: 0, w: 1 },
                };
            })();

            // Stay on the login art until the player clicks. The battle scene
            // hides #splash by dispatching elex-art-ready.
            (function () {
                function mark(ev) {
                    var boot = document.getElementById('boot');
                    if (boot && !boot.classList.contains('is-idle') && !boot.classList.contains('is-done')) return;
                    if (window.__tdSplashClicked) return;
                    window.__tdSplashClicked = true;
                    window.__tdSwallowInputUntil = Date.now() + 500;
                    if (ev.stopPropagation) ev.stopPropagation();
                    if (ev.preventDefault) ev.preventDefault();
                }
                window.addEventListener('pointerdown', mark, true);
                window.addEventListener('touchstart', mark, true);

                var done = false;
                function hideSplash() {
                    if (done) return;
                    done = true;
                    window.__elexArtReady = true;
                    var el = document.getElementById('splash');
                    if (!el) return;
                    el.classList.add('is-done');
                    el.style.setProperty('display', 'none', 'important');
                    el.style.setProperty('visibility', 'hidden', 'important');
                    el.style.setProperty('pointer-events', 'none', 'important');
                }
                if (window.__elexArtReady) hideSplash();
                else window.addEventListener('elex-art-ready', hideSplash);
            })();
        </script>
        <script src="./game-frame.js"></script>
    </body>
</html>
